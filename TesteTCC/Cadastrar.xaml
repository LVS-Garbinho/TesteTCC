<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TesteTCC.Cadastrar"
             Title="Cadastrar">
    <Grid>
        <!--Imagem de fundo -->
        <Image Source="fundo_tcc.png"
               Aspect="AspectFill"
               Opacity="0.3"
               ZIndex="0" />

        <!-- Conteúdo da tela -->
        <StackLayout Padding="100" ZIndex="1">
            <ScrollView>
                <VerticalStackLayout
                    Padding="30,0"
                    Spacing="25">

                    <Label Text="Nome:" />
                    <Entry x:Name="Nome" 
                        BackgroundColor="#2E3A59"
                        TextColor="#FFFFFF"/>
                    
                    <Label Text="Email:" />
                    <Entry x:Name="email" 
                        BackgroundColor="#2E3A59"
                        TextColor="#FFFFFF"/>
                    
                    <Label Text="CPF:" />
                    <Entry x:Name="cpf" 
                        BackgroundColor="#2E3A59"
                        TextColor="#FFFFFF"/>

                    <Label Text="Senha:" />
                    <Entry x:Name="Senha" 
                        BackgroundColor="#2E3A59"
                        TextColor="#FFFFFF"/>
                    
                    <Label Text="Confirmar Senha:" />
                    <Entry x:Name="SenhaCliente" 
                        BackgroundColor="#2E3A59"
                        TextColor="#FFFFFF"/>

                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" >
                        <Button
                            Text="Voltar" 
                            BackgroundColor="#2E3A59"
                            TextColor="#FFFFFF"
                            Clicked="Button_Clicked"/>
                        <Button
                            Text="Criar" 
                            BackgroundColor="#2E3A59"
                            TextColor="#FFFFFF"/>
                    </HorizontalStackLayout>
                    
                </VerticalStackLayout>
                    
            </ScrollView>

        </StackLayout>
    </Grid>
</ContentPage>