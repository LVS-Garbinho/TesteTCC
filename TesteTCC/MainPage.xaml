<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TesteTCC.MainPage">

    <Grid>
        <!--Imagem de fundo -->
        <Image Source="fundo_tcc.png"
               Aspect="AspectFill"
               Opacity="0.3"
               ZIndex="0" />

        <!-- Conteúdo da tela -->
        <StackLayout Padding="280" ZIndex="1">
            <ScrollView>
                <VerticalStackLayout
                    Padding="30,0"
                    Spacing="25">

                    <Label
                    Text="Coletix – Coletor de estoque mobile" />

                    <Button
                    Text="LOGIN"
                        Clicked="Button_Clicked_1"
                    BackgroundColor="#2E3A59"
                    TextColor="#FFFFFF"/>

                    <Button
                    Text="CADASTRAR" 
                        Clicked="Button_Clicked"
                    BackgroundColor="#2E3A59"
                    TextColor="#FFFFFF"/>

                </VerticalStackLayout>
            </ScrollView>

        </StackLayout>
    </Grid>

</ContentPage>
